{% extends 'base.html.twig' %}

{% block title %}Connexion - MATICES{% endblock %}

{% block body %}
<section class="section" style="min-height: 100vh; display: flex; align-items: center; background-color: var(--secondary-color); padding-top: 100px;">
    <div class="container">
        <div class="login-container">
            <div style="text-align: center; margin-bottom: 30px;">
                <h2 style="color: var(--primary-color); font-size: 2rem; letter-spacing: 3px;">MATICES</h2>
                <p style="color: rgba(255,255,255,0.6); margin-top: 5px;">Espace Membres</p>
            </div>

            {% if error %}
                <div style="background: rgba(255,76,41,0.15); border: 1px solid var(--primary-color); color: var(--light-color); padding: 12px 16px; border-radius: 5px; margin-bottom: 20px; font-size: 0.9rem;">
                    <i class="fas fa-exclamation-circle" style="color: var(--primary-color); margin-right: 8px;"></i>
                    {{ error.messageKey|trans(error.messageData, 'security') }}
                </div>
            {% endif %}

            <form method="post" class="login-form">
                <div class="form-group">
                    <label for="inputEmail" style="color: var(--light-color);">
                        <i class="fas fa-envelope" style="color: var(--primary-color); margin-right: 6px;"></i>Email
                    </label>
                    <input type="email" value="{{ last_username }}" name="_username" id="inputEmail"
                           autocomplete="email" required autofocus placeholder="votre@email.com">
                </div>
                <div class="form-group">
                    <label for="inputPassword" style="color: var(--light-color);">
                        <i class="fas fa-lock" style="color: var(--primary-color); margin-right: 6px;"></i>Mot de passe
                    </label>
                    <input type="password" name="_password" id="inputPassword"
                           autocomplete="current-password" required placeholder="••••••••">
                </div>
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
                <button class="btn btn-primary" type="submit" style="width: 100%; margin-top: 10px;">
                    <i class="fas fa-sign-in-alt" style="margin-right: 8px;"></i>Se connecter
                </button>
            </form>

            <p class="login-info" style="color: rgba(255,255,255,0.4); margin-top: 20px;">
                Accès réservé aux membres du groupe
            </p>
        </div>
    </div>
</section>
{% endblock %}
